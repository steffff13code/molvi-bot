# Telegram
TELEGRAM_BOT_TOKEN=
# SaluteSpeech (Сбер)
SALUTESPEECH_AUTH_KEY=
SALUTESPEECH_SCOPE=SALUTE_SPEECH_PERS

# GigaChat (Сбер)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat

# DB
DB_PATH=./data/molvi.db

# Limits (MVP)
MAX_AUDIO_MB=20
MAX_DURATION_SEC=1800

# HTTP
# Для MVP можно отключить проверку сертификата, если упираетесь в SSL-цепочку Сбера.
# В проде лучше добавить корректный CA и включить verify.
SBER_VERIFY_SSL=false

# Публичные ссылки (используются в меню и кнопках бота)
SITE_URL=https://molvi-ai.ru/
LANDING_URL=https://molvi-ai.ru/transcribe/
BOT_URL=https://t.me/molviai_bot
