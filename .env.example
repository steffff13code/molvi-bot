# ── Telegram ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── SaluteSpeech (Сбер, резервный STT) ───────────────────────────────
SALUTESPEECH_AUTH_KEY=
SALUTESPEECH_SCOPE=SALUTE_SPEECH_PERS

# ── GigaChat (Сбер, LLM для саммари) ─────────────────────────────────
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_STREAMS=1      # физлицу GigaChat даёт ровно 1 поток; поднимать только с тарифом ИП
# С 16.07.2026 единый адрес — api.giga.chat; GigaChat 3 Ultra на старом
# gigachat.devices.sberbank.ru недоступен физически (PR-16).
GIGACHAT_BASE_URL=https://api.giga.chat

# Модель на каждый шаг будущего конвейера рассуждения (PR-16/17/18). Пусто —
# используется GIGACHAT_MODEL. Меняется без релиза — нужно для замеров PR-17,
# например LLM_MODEL_WRITE=GigaChat-3-Ultra.
LLM_MODEL_EXTRACT=
LLM_MODEL_REDUCE=
LLM_MODEL_PLAN=
LLM_MODEL_WRITE=
LLM_MODEL_VERIFY=

# ── STT-провайдер ─────────────────────────────────────────────────────
# nexara  — Whisper-совместимый, принимает файл напрямую (основной)
# salute  — SaluteSpeech Сбера (резервный, требует конвертации в PCM)
STT_PROVIDER=nexara
NEXARA_API_KEY=

# ── База данных ───────────────────────────────────────────────────────
# На Railway — Volume: DB_PATH=/data/molvi.db
# Локально — оставьте пустым (будет ./data/molvi.db)
DB_PATH=

# ── Лимиты ────────────────────────────────────────────────────────────
FREE_MINUTES=60         # бесплатный лимит расшифровки на пользователя
PRICE_PER_HOUR=50       # ₽/час (только для текстов; платёжный шлюз не подключён)
TEMPLATE_RUNS_LIMIT=3   # разных шаблонов на одну запись без доплаты (повтор — из кэша, бесплатно)
RECORDS_RETENTION_DAYS=30  # хранение текста расшифровки в «Моих записях»; /forget удаляет раньше
MAX_AUDIO_MB=20         # потолок Telegram Bot API; большее значение всё равно зажимается кодом
MAX_DURATION_SEC=1800   # 30 мин; с PR-6 (ffmpeg вместо pydub) можно поднять до 7200 — потолок в коде

# ── Админ ─────────────────────────────────────────────────────────────
ADMIN_ID=              # ваш Telegram ID (число) — автоматически в whitelist + /stats
ADMIN_API_TOKEN=       # длинный случайный секрет для curl-доступа к /api/*
# Пароль веб-панели /admin — указывайте ТОЛЬКО хеш (безопаснее):
# Сгенерировать: python -c "import bcrypt; print(bcrypt.hashpw(b'ВАШ_ПАРОЛЬ', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH=   # bcrypt-хеш пароля (предпочтительно)
ADMIN_PASSWORD=        # plaintext-пароль (legacy, только если HASH не задан)

# ── HTTP (TLS для Сбера — GigaChat/SaluteSpeech) ──────────────────────
# Канал с полными расшифровками пользователей — verify=false отключает и проверку
# цепочки, и имени хоста. НЕ выключать вручную; если сертификат Сбера подписан
# корнем НУЦ Минцифры, а не публичным CA — положить бандл и указать путь ниже.
SBER_VERIFY_SSL=true
SBER_CA_BUNDLE=          # путь к russian_trusted_root_ca_pem.crt; пусто = системный certifi

# ── Публичные ссылки (используются в меню и кнопках бота) ────────────
SITE_URL=https://molvi-ai.ru/
LANDING_URL=https://molvi-ai.ru/transcribe/
BOT_URL=https://t.me/molviai_bot
